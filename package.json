{
  "name": "clientdesk",
  "version": "0.9.0-rc.1",
  "description": "ClientDesk desktop customer management app.",
  "main": "out/main/index.js",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "ensure:electron": "node node_modules/electron/install.js",
    "test": "npm run ensure:electron && npm rebuild better-sqlite3 && vitest run",
    "test:integration": "npm run ensure:electron && npm rebuild better-sqlite3 && vitest run tests/integration",
    "posttest:integration": "npm run rebuild:electron",
    "test:package": "node scripts/verify-package.mjs",
    "test:watch": "vitest",
    "posttest": "npm run rebuild:electron",
    "postinstall": "electron-builder install-app-deps",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "publish:win": "npm run build && electron-builder --win nsis --x64 --publish always",
    "release:check": "node scripts/verify-release-version.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "verify:package": "node scripts/verify-package.mjs",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3 -v 42.4.1",
    "supabase:link": "supabase link",
    "supabase:status": "supabase migration list",
    "supabase:push:dry": "supabase db push --dry-run",
    "supabase:push": "supabase db push"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/supabase-js": "^2.108.2",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.4.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "supabase": "^2.108.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  }
}
